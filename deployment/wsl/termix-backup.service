[Unit]
Description=Consistent local backup of Termix

[Service]
Type=oneshot
EnvironmentFile=-%E/seia-wsl/termix-backup.env
ExecStart=/usr/bin/python3 "%h/.local/lib/seia-wsl/backup-termix.py"
ExecStopPost=/usr/bin/python3 "%h/.local/lib/seia-wsl/backup-termix.py" --resume
TimeoutStartSec=15min
TimeoutStopSec=30s
UMask=0077
